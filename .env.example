# ── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Base pública, JÁ COM o prefixo de versão — usada para montar URL de arquivo
PUBLIC_URL=http://localhost:3000/v1
ALLOW_ORIGIN_LIST=http://localhost:3000,http://localhost:5173

# ── Autenticação ─────────────────────────────────────────────────────────────
API_KEY_PREFIX=zelo_
# Enum fechado: ZELO_APP | ZELO_APP_STAGING | ZELO_APP_DEV
SESSION_COOKIE_NAME=ZELO_APP_DEV

# ── PostgreSQL (fonte da verdade) ─────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=zelo
PG_PASSWORD=zelo
PG_DB_NAME=zelo
PG_SSL=false
PG_POOL_MAX=10
# Deixe FORA do .env.<NODE_ENV>: declarar aqui sobrescreve o `npm run dev:sql`
SQL_LOG_STATEMENTS=

# ── Armazenamento de mídia ───────────────────────────────────────────────────
STORAGE_ROOT=./uploads
UPLOAD_MAX_FILE_SIZE=10485760

# ── Log de request/response no MongoDB (acessório, opt-in) ───────────────────
MONGO_LOG_ENABLED=false
MONGO_URI=
MONGO_DB_NAME=
MONGO_LOG_COLLECTION=logs
MONGO_LOG_MAX_BODY_SIZE=10240
