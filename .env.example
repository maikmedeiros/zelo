# ── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
PUBLIC_URL=
ALLOW_ORIGIN_LIST=

# ── Autenticação ─────────────────────────────────────────────────────────────
API_TOKEN_PREFIX=zelo_
SESSION_COOKIE_NAME=ZELO_APP_DEV

# ── PostgreSQL ─────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=zelo
PG_PASSWORD=zelo
PG_DB_NAME=zelo
PG_SSL=false
PG_POOL_MAX=10
# Aplica as migrations pendentes no boot. Padrão: ligada fora de produção.
DB_AUTO_MIGRATE=true
SQL_LOG_STATEMENTS=

# ── Armazenamento de mídia ───────────────────────────────────────────────────
STORAGE_ROOT=./public/imagens
UPLOAD_MAX_FILE_SIZE=10485760

# ── MONGO (LOGS) ─────────────────────────────────────────────
MONGO_LOG_ACTIVE=false
MONGO_URI=
MONGO_DB_NAME=
MONGO_LOG_COLLECTION=logs
MONGO_LOG_MAX_BODY_SIZE=10240
